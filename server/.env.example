PORT=4000
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
CLIENT_ORIGIN=http://localhost:5173

# Local: levantada por el docker-compose.yml de la raiz (docker compose up -d).
# Railway: no pongas la URL a mano — en el servicio "server" agrega la variable
# DATABASE_URL referenciando el plugin de Postgres (${{Postgres.DATABASE_URL}}),
# asi usa la conexion interna del proyecto (sin costo de egress, sin SSL).
DATABASE_URL=postgres://chat:chat@localhost:5432/chat_multisala

# TURN relay para llamadas de camara (plan Pro). Sin configurar ninguna de
# las dos opciones de abajo, Free y Pro se comportan igual (solo STUN).

# Opcion 1 (preferida): Metered.ca con credenciales dinamicas de corta
# duracion. Domain y Secret Key salen del dashboard, seccion "Turn Server".
# Ojo: METERED_SECRET_KEY es la clave de gestion (server-only) que el
# codigo usa para MINAR una credencial de corta vida — no es la que se
# manda al navegador, eso lo maneja routes/calls.js solo.
# METERED_DOMAIN=tuapp.metered.live
# METERED_SECRET_KEY=tu-secret-key

# Opcion 2: TURN estatico (coturn propio, Xirsys, Twilio, etc). Cualquier
# URI TURN estandar sirve sin tocar codigo.
# TURN_URL=turn:tu-servidor-turn.example.com:3478
# TURN_USERNAME=usuario-turn
# TURN_CREDENTIAL=password-turn
